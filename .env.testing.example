# Copy to .env.testing; keep the populated file private.
APP_ENV=testing
# Generate a test-only key locally; do not copy a production APP_KEY.
APP_KEY=
DB_CONNECTION=mysql_testing
# Inside Compose use mysql:3306. From the host use 127.0.0.1:3307.
TEST_DB_HOST=mysql
TEST_DB_PORT=3306
# Provision a dedicated empty database and a user restricted to that database.
# The name must end in _test or _testing and differ from the application database.
TEST_DB_DATABASE=budget_system_test
TEST_DB_USERNAME=budget_test
# Supply the dedicated test user's password locally; no shared default password.
TEST_DB_PASSWORD=
SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
MAIL_MAILER=array
